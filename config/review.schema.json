{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "date",
    "summary",
    "must_read",
    "worth_reading",
    "later",
    "skip",
    "deep_dives",
    "trend_observations",
    "tomorrow_followups"
  ],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "summary": {"type": "string", "minLength": 20},
    "must_read": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/paper_decision"}
    },
    "worth_reading": {"type": "array", "items": {"$ref": "#/$defs/paper_decision"}},
    "later": {"type": "array", "items": {"$ref": "#/$defs/paper_decision"}},
    "skip": {"type": "array", "items": {"$ref": "#/$defs/paper_decision"}},
    "deep_dives": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/deep_dive"}
    },
    "trend_observations": {"type": "array", "items": {"type": "string"}},
    "tomorrow_followups": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "paper_decision": {
      "type": "object",
      "required": [
        "canonical_id",
        "title",
        "decision",
        "one_sentence",
        "reason",
        "relevance",
        "suggested_action"
      ],
      "properties": {
        "canonical_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string"},
        "decision": {"type": "string", "enum": ["必读", "值得看", "稍后", "跳过"]},
        "one_sentence": {"type": "string", "minLength": 10},
        "reason": {"type": "string", "minLength": 10},
        "relevance": {"type": "string", "minLength": 2},
        "reusable_idea": {"type": "string"},
        "uncertainty": {"type": "string"},
        "suggested_action": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "deep_dive": {
      "type": "object",
      "required": [
        "canonical_id",
        "title",
        "source_basis",
        "tldr",
        "summary_zh",
        "problem",
        "method",
        "core_innovations",
        "evidence",
        "limitations",
        "relevance_to_me",
        "reusable_ideas",
        "questions_to_check",
        "reading_priority"
      ],
      "properties": {
        "canonical_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string"},
        "source_basis": {"type": "string", "enum": ["title+abstract", "html", "pdf", "html+pdf"]},
        "tldr": {"type": "string", "minLength": 10},
        "summary_zh": {"type": "string", "minLength": 20},
        "problem": {"type": "string", "minLength": 10},
        "method": {"type": "string", "minLength": 10},
        "core_innovations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "relevance_to_me": {"type": "string", "minLength": 10},
        "reusable_ideas": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "questions_to_check": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "reading_priority": {"type": "string", "minLength": 5},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
